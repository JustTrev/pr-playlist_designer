<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>AnyCPU;x64</Platforms>
    <ApplicationIcon>map-icon_enhanced128x128.ico</ApplicationIcon>
    <Title>Project Reclaimer Playlist Designer</Title>
    <Copyright>xSoMuchPot 10/15/2026</Copyright>
    <PackageIcon>343GS.png</PackageIcon>
    <AssemblyVersion>1.1.2.0</AssemblyVersion>
    <FileVersion>1.1.2.0</FileVersion>
    <IncludeSymbols>False</IncludeSymbols>
    <Description>A playlist maker for hosting dedicated servers for Project Reclaimer</Description>
    <PackageProjectUrl>https://github.com/JustTrev/pr-playlist_designer</PackageProjectUrl>
    <Authors>xSoMuchPot</Authors>
    <Company>xSoMuchPotx</Company>
    <Product>PR Playlist Designer</Product>
    <PackageId>PRPlaylistDesigner</PackageId>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <AssemblyName>PRPlaylistDesigner</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="map-icon_enhanced128x128.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\..\Pictures\343GS.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>